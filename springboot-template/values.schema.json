{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "replicaCount": {
        "type": "integer",
        "minimum": 1,
        "default": 1,
        "description": "Number of replicas for the deployment"
      },
      "image": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "default": "thingvance/iam-application",
            "description": "Docker image repository"
          },
          "pullPolicy": {
            "type": "string",
            "enum": ["Always", "IfNotPresent", "Never"],
            "default": "Always",
            "description": "Image pull policy"
          },
          "tag": {
            "type": "string",
            "default": "1.1.5",
            "description": "Docker image tag"
          }
        },
        "required": ["repository", "pullPolicy", "tag"],
        "additionalProperties": false
      },
      "fullnameOverride": {
        "type": "string",
        "default": "iam",
        "description": "Override the full name of the chart"
      },
      "service": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["ClusterIP", "NodePort"],
            "default": "ClusterIP",
            "description": "Service type"
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the port"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535,
                  "description": "Port number"
                },
                "protocol": {
                  "type": "string",
                  "enum": ["TCP", "UDP", "SCTP"],
                  "description": "Port protocol"
                },
                "nodePort": {
                  "type": "integer",
                  "minimum": 30000,
                  "maximum": 32767,
                  "description": "NodePort number (only applicable when service.type is NodePort)"
                }
              },
              "required": ["name", "port", "protocol"],
              "if": {
                "properties": {
                  "nodePort": { "type": "integer" }
                },
                "required": ["nodePort"]
              },
              "then": {
                "properties": {
                  "nodePort": { "minimum": 30000, "maximum": 32767 }
                }
              }
            },
            "default": [
              {
                "name": "web",
                "port": 8080,
                "protocol": "TCP"
              }
            ],
            "description": "List of service ports"
          }
        },
        "required": ["type", "ports"],
        "additionalProperties": false
      },
      "volumes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Name of the volume"
            },
            "configMap": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the ConfigMap"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "description": "Key in the ConfigMap"
                      },
                      "path": {
                        "type": "string",
                        "description": "Path to mount the key"
                      }
                    },
                    "required": ["key", "path"]
                  },
                  "description": "Items to mount from the ConfigMap"
                }
              },
              "required": ["name", "items"]
            }
          },
          "required": ["name", "configMap"]
        },
        "default": [
          {
            "name": "config",
            "configMap": {
              "name": "iam-conf",
              "items": [
                {
                  "key": "application.properties",
                  "path": "application.properties"
                }
              ]
            }
          }
        ],
        "description": "List of volumes for the pod"
      },
      "configMap": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable or disable ConfigMap"
          },
          "name": {
            "type": "string",
            "default": "application.properties",
            "description": "Name of the ConfigMap key (e.g., application.properties or application.yml)"
          },
          "content": {
            "type": "string",
            "default": "spring.datasource.url=jdbc:postgresql://localhost:5432/mydb\nspring.datasource.username=admin\nspring.datasource.password=secret\nserver.port=8080",
            "description": "Content of the configuration file (e.g., application.properties or application.yml)"
          }
        },
        "required": ["enabled", "name", "content"],
        "additionalProperties": false
      }
    },
    "required": [
      "replicaCount",
      "image",
      "fullnameOverride",
      "service",
      "volumes",
      "configMap"
    ],
    "additionalProperties": false
  }